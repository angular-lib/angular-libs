{
  "name": "angular-libs",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve demo",
    "socket": "bun run server/server.ts",
    "build": "ng build demo",
    "build:pages": "ng build demo --configuration=production --base-href=/angular-libs/",
    "build:libs": "ng build @angular-libs/dialog && ng build @angular-libs/event-bus && ng build @angular-libs/shortcut && ng build @angular-libs/socket && ng build @angular-libs/store && ng build @angular-libs/translate && ng build @angular-libs/web && ng build @angular-libs/data-grid && ng build @angular-libs/form",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "private": true,
  "packageManager": "bun@1.1.20",
  "dependencies": {
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/router": "^22.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.0.1",
    "@angular/cli": "^22.0.1",
    "@angular/compiler-cli": "^22.0.0",
    "bun-types": "^1.3.14",
    "jsdom": "^28.0.0",
    "ng-packagr": "^22.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  }
}
